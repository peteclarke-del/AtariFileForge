<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-atari-st">
    <comment>Atari ST floppy sector image</comment>
    <glob pattern="*.st"/>
  </mime-type>
  <mime-type type="application/x-atari-msa">
    <comment>Magic Shadow Archiver floppy image</comment>
    <glob pattern="*.msa"/>
  </mime-type>
  <mime-type type="application/x-atari-dim">
    <comment>FastCopy Pro floppy image</comment>
    <glob pattern="*.dim"/>
  </mime-type>
  <mime-type type="application/x-atari-stx">
    <comment>Pasti protected floppy image</comment>
    <glob pattern="*.stx"/>
  </mime-type>
  <mime-type type="application/x-atari-hd">
    <comment>Atari ACSI, SCSI or IDE hard-disk image</comment>
    <glob pattern="*.ahd"/><glob pattern="*.acsi"/><glob pattern="*.ide"/>
    <glob pattern="*.hd"/>
  </mime-type>
  <mime-type type="application/x-atari-rom">
    <comment>Atari TOS or cartridge ROM image</comment>
    <glob pattern="*.tos"/><glob pattern="*.rom"/>
  </mime-type>
  <mime-type type="application/x-atari-hfe">
    <comment>HxC floppy image</comment>
    <glob pattern="*.hfe"/>
  </mime-type>
  <mime-type type="application/x-atari-scp">
    <comment>SuperCard Pro flux capture</comment>
    <glob pattern="*.scp"/>
  </mime-type>
</mime-info>
