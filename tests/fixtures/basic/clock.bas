10 REM CLOCK.BAS - a made-up demo for the Atari File Forge test corpus
20 FULLW 2:CLEARW 2
30 COLOR 1,1,1,1,1
40 DIM HOUR$(12)
50 FOR I%=1 TO 12:READ HOUR$(I%):NEXT I%
60 DATA ONE,TWO,THREE,FOUR,FIVE,SIX,SEVEN,EIGHT,NINE,TEN,ELEVEN,TWELVE
70 GOTOXY 2,2:PRINT "ATARI ST BASIC CLOCK"
80 DEF FNRAD(D)=D*3.14159265/180
90 CIRCLE 160,100,80
100 FOR A%=0 TO 330 STEP 30
110 X%=160+70*COS(FNRAD(A%)):Y%=100+70*SIN(FNRAD(A%))
120 LINEF 160,100,X%,Y%
130 NEXT A%
140 WHILE INKEY$=""
150 WEND
160 ON ERROR GOTO 200
170 SOUND 1,15,8,4,10
180 GOSUB 1000
190 GOTO 220
200 PRINT "error";ERR;"at line";ERL:RESUME 220
210 REM the tidy-up section
220 CLEARW 2:END
1000 FOR J%=1 TO 12:PRINT HOUR$(J%);" ";:NEXT J%:PRINT
1010 RETURN