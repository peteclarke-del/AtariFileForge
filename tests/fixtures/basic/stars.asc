10 rem STARS.BAS -- a made-up demo for the Atari File Forge test corpus
20 mode 0 : curs off : clw
30 dim X(64),Y(64)
40 COUNT=64 : SPEED=2.5
50 for I=1 to COUNT
60 X(I)=rnd(320) : Y(I)=rnd(200)
70 next I
80 palette $0,$777,$555,$333
90 repeat
100 wait vbl
110 for I=1 to COUNT
120 ink 0 : plot X(I),Y(I)
130 X(I)=X(I)+SPEED
140 if X(I)>319 then X(I)=0 : Y(I)=rnd(200)
150 ink 1 : plot X(I),Y(I)
160 next I
170 until mouse key=1
180 curs on : print "stars drawn: ";COUNT
190 end
